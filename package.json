{
  "name": "@konopskidev/ui",
  "version": "0.2.1",
  "description": "The konopskidev design system: shadcn/ui components styled with the konopskidev tokens on Tailwind CSS v4.",
  "keywords": [
    "shadcn",
    "radix-ui",
    "tailwindcss",
    "react",
    "design-system",
    "components",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misiekhardcore/konopskidevui.git"
  },
  "homepage": "https://github.com/misiekhardcore/konopskidevui#readme",
  "bugs": {
    "url": "https://github.com/misiekhardcore/konopskidevui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./components/*": {
      "import": {
        "types": "./dist/components/ui/*.d.ts",
        "default": "./dist/components/ui/*.js"
      },
      "require": {
        "types": "./dist/components/ui/*.d.cts",
        "default": "./dist/components/ui/*.cjs"
      }
    },
    "./lib/*": {
      "import": {
        "types": "./dist/lib/*.d.ts",
        "default": "./dist/lib/*.js"
      },
      "require": {
        "types": "./dist/lib/*.d.cts",
        "default": "./dist/lib/*.cjs"
      }
    },
    "./hooks/*": {
      "import": {
        "types": "./dist/hooks/*.d.ts",
        "default": "./dist/hooks/*.js"
      },
      "require": {
        "types": "./dist/hooks/*.d.cts",
        "default": "./dist/hooks/*.cjs"
      }
    },
    "./lib/highlighter": {
      "import": {
        "types": "./dist/lib/highlighter.d.ts",
        "default": "./dist/lib/highlighter.js"
      }
    },
    "./hooks/use-highlighted-code": {
      "import": {
        "types": "./dist/hooks/use-highlighted-code.d.ts",
        "default": "./dist/hooks/use-highlighted-code.js"
      }
    },
    "./styles.css": "./dist/styles/globals.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "node scripts/build.mjs",
    "build:storybook": "storybook build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tsc": "tsc --noEmit",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:stories": "vitest run --project=storybook",
    "test:coverage": "vitest run --project=unit --coverage",
    "verify:package": "publint && attw --pack . --profile node16 --exclude-entrypoints ./styles.css ./lib/highlighter ./hooks/use-highlighted-code",
    "verify": "pnpm lint && pnpm tsc && pnpm test && pnpm build && pnpm test:package && pnpm verify:package",
    "style": "node scripts/apply-house-style.mjs && prettier --write \"src/components/ui/**/*.tsx\"",
    "barrel": "node scripts/generate-barrel.mjs",
    "prepare": "husky",
    "test:package": "node scripts/test-package.mjs"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": ">=0.4 <2",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.15.0",
    "recharts": "3.8.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.0.0",
    "vaul": "^1.1.2"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "@shadcn/react": {
      "optional": true
    },
    "cmdk": {
      "optional": true
    },
    "embla-carousel-react": {
      "optional": true
    },
    "input-otp": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "react-resizable-panels": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "sonner": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "vaul": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@base-ui/react": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "input-otp": "^1.5.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "storybook": "10.6.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vaul": "^1.1.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "radix-ui": "^1.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts"
}
